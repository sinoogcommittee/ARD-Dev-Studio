# ============================================================================
# ARD Dev Studio — Environment Configuration Template
# Copy this file to .env.local and populate with your Supabase credentials:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or your private service keys to Git!
# ============================================================================

# Your Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public / Anon Key (safe for frontend use with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
