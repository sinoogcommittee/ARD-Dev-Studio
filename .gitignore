# ============================================================================
# Git Ignore Configuration: ARD Dev Studio
# ============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build artifacts
dist/
dist-ssr/

# Environment and secrets (CRITICAL: never commit credentials)
.env
.env.*
!.env.example
*.local

# Supabase local CLI artifacts & temporary state
.supabase/
supabase/.temp/

# Logs & debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Vite & build cache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.eslintcache

# Editor and OS system files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
